QWidget#ConfirmationModal, QWidget#ShortcutsModal {
    background-color: rgba(0, 0, 0, 0.65);
}

QFrame#ActionCenterCard {
    background-color: {bg_rgba};
    border: 1px solid {border_rgba};
    border-radius: {border_radius};
    color: {title_rgba};
    font-family: 'Segoe UI', sans-serif;
}

QLabel#ActionCenterTitle {
    color: {title_rgba};
    font-size: 14px;
    font-weight: bold;
    background: transparent;
}

QFrame#ConfirmOverlay, QFrame#ShortcutsOverlay {
    background-color: {bg_rgba};
    border-radius: {border_radius};
}

QLabel#ConfirmTitle {
    color: {error_rgba};
    background: transparent;
}

QLabel#ConfirmMsg {
    color: {body_rgba};
    background: transparent;
}

QPushButton#DestructionYesBtn {
    background-color: {error_rgba};
    color: {bg_rgba};
    border: none;
    border-radius: 5px;
    padding: 6px 14px;
    font-weight: bold;
}

QPushButton#DestructionYesBtn:hover {
    background-color: {accent_rgba};
}

QPushButton#DestructionNoBtn {
    background-color: {hover_rgba};
    color: {title_rgba};
    border: none;
    border-radius: 5px;
    padding: 6px 14px;
}

QPushButton#DestructionNoBtn:hover {
    background-color: {title_rgba};
    color: {bg_rgba};
}

/* Sidebar Date Filters */
QPushButton.SidebarFilterBtn {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    color: {body_rgba};
    text-align: left;
    font-size: 13px;
}

QPushButton.SidebarFilterBtn:hover {
    background-color: {hover_rgba};
    color: {title_rgba};
}

QPushButton.SidebarFilterBtn:checked {
    background-color: {hover_rgba};
    color: {title_rgba};
    font-weight: bold;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: {border_rgba};
    min-height: 25px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: {accent_rgba};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QLineEdit#SearchInput {
    background-color: {search_bg};
    border: 1px solid {border_rgba};
    border-radius: 6px;
    padding: 8px 12px;
    color: {title_rgba};
}

QLineEdit#SearchInput:focus {
    border: 2px solid {accent_rgba};
}

QPushButton#DndBtn, QPushButton#SettingsBtn, QPushButton#ShortcutsFooterBtn, QPushButton#ConfirmYesBtn {
    background-color: {hover_rgba};
    border: 1px solid {border_rgba};
    border-radius: 6px;
    padding: 5px 12px;
    color: {title_rgba};
    font-weight: bold;
}

QPushButton#DndBtn:hover, QPushButton#DndBtn:checked {
    background-color: {dnd_rgba};
    color: {bg_rgba};
}

QPushButton#SettingsBtn:hover, QPushButton#ShortcutsFooterBtn:hover, QPushButton#ConfirmYesBtn:hover {
    background-color: {accent_rgba};
    color: {bg_rgba};
}

QPushButton#ClearBtn {
    background-color: transparent;
    border: 1px solid {error_rgba};
    border-radius: 6px;
    padding: 5px 12px;
    color: {error_rgba};
    font-weight: bold;
}

QPushButton#ClearBtn:hover {
    background-color: {error_rgba};
    color: {bg_rgba};
}

QLabel#SortLabel, QLabel#ViewLabel {
    color: {body_rgba};
    font-size: 13px;
    background: transparent;
}

QComboBox#SortCombo, QComboBox#ViewCombo {
    background-color: {search_bg};
    border: 1px solid {border_rgba};
    border-radius: 6px;
    padding: 4px 8px;
    color: {body_rgba};
}

QComboBox#SortCombo::drop-down, QComboBox#ViewCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: none;
}

QComboBox QAbstractItemView {
    background-color: {bg_rgba};
    color: {body_rgba};
    border: 1px solid {border_rgba};
    border-radius: 6px;
    padding: 4px;
    outline: 0px;
    selection-background-color: {hover_rgba};
    selection-color: {title_rgba};
}

QFrame#ConfirmOverlay {
    border: 1px solid {error_rgba};
}

QLabel#ShortcutsOverlay {
    border: 1px solid {border_rgba};
}

QLabel#ShortcutsTitle {
    color: {title_rgba};
    background: transparent;
}

QLabel#ShortcutKeyChip {
    background-color: {hover_rgba};
    color: {accent_rgba};
    border: 1px solid {border_rgba};
    border-radius: {border_radius};
    padding: 3px 6px;
    font-family: 'Segoe UI', monospace;
    font-size: 11px;
    font-weight: 600;
}

QLabel#ShortcutDescLabel {
    color: {muted_rgba};
    font-size: 12px;
}