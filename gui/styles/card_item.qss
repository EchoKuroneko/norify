QFrame#Card {
    background-color: {card_bg_rgba};
    border: 1px solid {card_border_rgba};
    border-radius: {border_radius};
}

QFrame#Card QLabel {
    background: transparent;
    border: none;
}

QFrame#Card QWidget {
    background: transparent;
}

QLabel#CardTitleLabel {
    color: {title_rgba};
    background: transparent;
}

QLabel#CardTimeLabel {
    color: {muted_rgba};
    background: transparent;
}

QLabel#CardMsgLabel {
    color: {msg_rgba};
    background: transparent;
}

QPushButton#CardDeleteBtn {
    background: transparent;
    border: none;
    color: {error_rgba};
    font-size: 11px;
    padding: 2px 4px;
    border-radius: 3px;
}

QPushButton#CardDeleteBtn:hover {
    background-color: {error_rgba};
    color: {bg_rgba};
}