QWidget {
    background-color: transparent;
}

QScrollArea#GroupScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea#GroupScrollArea > QWidget > QWidget {
    background: transparent;
}

QWidget#GroupListContainer {
    background: transparent;
}

QFrame#GroupFrame {
    background: transparent;
    border: none;
}

QWidget#GroupHeaderBar {
    background-color: {group_header_bg_rgba};
    border: 1px solid {group_header_border_rgba};
    border-radius: {border_radius};
}

QWidget#GroupHeaderBar:hover {
    background-color: {group_header_hover_rgba};
}

QLabel#GroupArrowLabel {
    border: none;
    background: transparent;
}

QLabel#GroupTitleLabel {
    color: {title_rgba};
    border: none;
    background: transparent;
}

QPushButton#GroupClearBtn {
    background: transparent;
    border: none;
    color: {error_rgba};
    font-size: 11px;
    padding: 2px 4px;
    border-radius: 3px;
}

QPushButton#GroupClearBtn:hover {
    background-color: {error_rgba};
    color: {bg_opaque};
}

QWidget#GroupItemsContainer {
    background: transparent;
}

QLabel#EmptyNoticeLabel {
    color: {muted_rgba};
    margin-top: 30px;
}